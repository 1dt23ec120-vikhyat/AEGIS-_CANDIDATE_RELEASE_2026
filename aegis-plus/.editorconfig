# EditorConfig — consistent editor behaviour across the team.
# Standards: Development_Standards.md (4-space indent, UTF-8, LF).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4

[*.{yaml,yml,json,toml}]
indent_size = 2

[*.md]
# Preserve trailing spaces (Markdown hard line breaks).
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
